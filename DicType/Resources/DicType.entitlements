<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under the hardened runtime to reach the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- NOT sandboxed on purpose. A sandboxed app cannot post CGEvents
         into other applications, which is the entire point of DicType. -->
</dict>
</plist>
